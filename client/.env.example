VITE_IK_PUBLIC_KEY = 'Image Kit Public Key'
VITE_IK_STATIC_IMG_BASE = 'Base folder applied to the path of static images loaded from image kit'
VITE_CLERK_PUBLISHABLE_KEY='Clerk Public Key'
VITE_API_URL = 'base url for api'
